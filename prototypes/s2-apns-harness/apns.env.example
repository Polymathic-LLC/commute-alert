# Copy to .secrets/apns.env and fill in. .secrets/ is gitignored.
#
# APNS_KEY_ID   — the 10-char Key ID shown when you create the APNs Auth Key,
#                 and embedded in the downloaded filename AuthKey_<KEYID>.p8.
#                 REQUIRED. No default (it is minted with the key).
# APNS_TEAM_ID  — 10-char Apple Developer Team ID. Optional; defaults to the
#                 S3-probe team MSQSPT8P3W.
# APNS_BUNDLE_ID— the throwaway app's bundle id. Optional; defaults to
#                 com.polymathic.commutealert.s3probe. MUST match S3's Xcode
#                 project exactly or every Live Activity push fails silently
#                 with the wrong apns-topic.

APNS_KEY_ID=
APNS_TEAM_ID=MSQSPT8P3W
APNS_BUNDLE_ID=com.polymathic.commutealert.s3probe

# Also drop the key file here:
#   .secrets/AuthKey_<KEYID>.p8
